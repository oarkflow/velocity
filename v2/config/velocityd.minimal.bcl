plugin "storage-mem" {
  enabled true
  config {
    _notes "Minimal deployment: in-memory storage + KV only, no crypto/auth/object/secret/sql/search/web/compliance/replication/metrics. Demonstrates that a manifest, not a recompile, decides what runs — see docs/ARCHITECTURE.md section (e)."
  }
}

plugin "kv" {
  enabled true
  config {
    _notes "Optional encryption-at-rest is available (set encrypt: true + enable a crypto-* plugin) but off here to keep this manifest truly minimal."
    encrypt false
  }
}
