plugin "storage-lsm" {
  enabled true
  config {
    always_sync true
    dir "./data/velocityd"
  }
}

plugin "storage-mem" {
  enabled false
  config {
    _notes "In-memory StorageBackend alternative to storage-lsm. Only one storage-* plugin may be enabled at a time — whichever one is enabled registers the fixed service name 'storage' that every other plugin looks up. Swapping backends is exactly this: flip these two 'enabled' flags, nothing else changes."
  }
}

plugin "crypto-xchacha" {
  enabled true
  config {
    _notes "Default crypto provider (XChaCha20-Poly1305). If 'key' is left empty, the plugin generates a random ephemeral key for this process only and logs a Warn — fine for local/dev, NOT for production, since data becomes unreadable across restarts. Set an explicit persistent key before running against real data."
    key ""
  }
}

plugin "crypto-fips" {
  enabled false
  config {
    _notes "FIPS-style alternative (AES-256-GCM + PBKDF2) to crypto-xchacha. Only one crypto-* plugin may be enabled at a time, same swap pattern as storage-lsm/storage-mem."
  }
}

plugin "kv" {
  enabled true
  config {
    _notes `Optional, off by default (zero behavior change unless set). When true, values (not keys) are encrypted at rest via whichever "crypto" service is registered (e.g. crypto-xchacha above) — Init fails loudly if encrypt is true but no crypto-* plugin is enabled, rather than silently storing plaintext.`
    encrypt false
  }
}

plugin "object" {
  enabled true
  config {
    _notes `Optional, off by default (zero behavior change unless set). When true, values (not keys) are encrypted at rest via whichever "crypto" service is registered (e.g. crypto-xchacha above) — Init fails loudly if encrypt is true but no crypto-* plugin is enabled, rather than silently storing plaintext.`
    encrypt false
  }
}

plugin "secret" {
  enabled true
  config {
  }
}

plugin "auth-jwt" {
  enabled true
  config {
    _notes "REQUIRED. v1 shipped with a default/hardcoded JWT secret that a pentest found allows admin-token forgery. This plugin's Init refuses to start if 'secret' is empty — there is no built-in fallback. Generate a real random secret (e.g. `openssl rand -base64 48`) and put it here (or better, load it from an environment variable / secret manager in your own deployment tooling) before running against anything real."
    secret "CHANGE-ME-set-a-real-secret-before-production"
  }
}

plugin "auth-ldap" {
  enabled false
  config {
  }
}

plugin "auth-oidc" {
  enabled false
  config {
  }
}

plugin "auth-sts" {
  enabled false
  config {
  }
}

plugin "auth-mfa" {
  enabled false
  config {
    _notes "TOTP/HOTP second-factor (RFC 4226/6238). Disabled by default — enable once auth-jwt (or another primary Authenticator) is in place, since MFA layers on top of a primary credential rather than replacing one."
  }
}

plugin "compliance" {
  enabled true
  config {
  }
}

plugin "replication" {
  enabled false
  config {
    _notes "Gossip-style membership + async, eventually-consistent replication only — no consensus/quorum protocol. Disabled by default for a single-node deployment; enable for a multi-node cluster."
  }
}

plugin "sql" {
  enabled true
  config {
  }
}

plugin "search" {
  enabled true
  config {
  }
}

plugin "web" {
  enabled true
  config {
    addr ":8090"
  }
}

plugin "metrics" {
  enabled true
  config {
  }
}

plugin "backup" {
  enabled true
  config {
    _notes "HMAC-signed Backup/Restore/Export/Import. Uses its OWN key (independent of the crypto plugin) so backups stay verifiable even if crypto config changes later. Same 'empty generates an ephemeral key + Warn' pattern as crypto-xchacha — set a persistent 'hmac_key' before relying on this for real disaster recovery."
    hmac_key ""
  }
}

plugin "envelope" {
  enabled true
  config {
  }
}

plugin "erasure" {
  enabled false
  config {
    _notes "GF(2^8) erasure coding + bit-rot detection + self-healing, as an opt-in add-on shard store (service name 'erasure'). The object plugin can route large object bodies through it via its own 'use_erasure_for_large_objects'/'erasure_threshold_bytes' config keys once this is enabled — disabled by default since its background scan loop adds overhead most single-node/dev deployments don't need."
  }
}

plugin "notifications" {
  enabled true
  config {
  }
}

plugin "lock" {
  enabled true
  config {
  }
}

plugin "extractor" {
  enabled true
  config {
  }
}

plugin "iam" {
  enabled true
  config {
  }
}

plugin "redisdata" {
  enabled true
  config {
    _notes "Redis-compatible List/Set/Hash/SortedSet/PubSub data structures, atop the same storage backend as everything else."
  }
}

plugin "resp" {
  enabled true
  config {
    _notes "Real RESP2 wire-protocol server — point redis-cli or any Redis client at this port. Listens on :6380 (not Redis's default :6379) so it never collides with a real Redis instance on the same machine. See v2/benchmarks/comparison/redis/RESULTS.md for real measured numbers against actual Redis, including scope limitations (no Lua, transactions, cluster mode, or pipelining-optimized throughput yet)."
    addr ":6380"
  }
}

plugin "document" {
  enabled true
  config {
    _notes `JSON documents with dot-notation Get/Set/Delete (e.g. "user.address.city", "tags.0"), atop the same storage backend as kv.`
  }
}

plugin "configio" {
  enabled true
  config {
    _notes "Export a kv namespace as .env or flat JSON; import .env or nested JSON into a kv namespace (dot-notation flattening)."
  }
}

plugin "sandbox" {
  enabled false
  config {
    _notes "REQUIRED before enabling: set allowed_commands to an explicit list of binaries this deployment may execute — there is no wildcard default-allow, and an empty list means every Run call is refused (safe, but inert). Disabled by default since it grants subprocess-execution capability, which should be an explicit operator decision, not a default. Never invokes a shell (no /bin/sh -c) — arguments are passed as a literal array, so shell metacharacters in an argument are always inert data. Automatically upgrades to real OS-level sandboxing (macOS sandbox-exec, checked live) when available; SandboxResult.Mode reports exactly which isolation level was actually applied — see plugins/sandbox's doc comment. Use RunWithSecrets to inject values from the secret store as environment variables without ever writing them to disk or logs (this is v2's real implementation of the 'secretr exec' concept v1 only ever referenced in an example, never built)."
    allowed_commands []
    default_max_output_bytes "1048576"
    default_timeout "30s"
  }
}
